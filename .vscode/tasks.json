{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build student.cpp",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wno-unused-parameter",
                "${workspaceFolder}/src/student.cpp",
                "-o",
                "${workspaceFolder}/latihan"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: mingw-get.exe build active file",
            "command": "c:\\MinGW\\bin\\mingw-get.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "c:\\MinGW\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}